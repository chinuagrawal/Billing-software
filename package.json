{
  "name": "agrawal-enterprises-billing",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && npm run build:api && npm run test:server-runtime",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "format": "prettier --write src server api *.json *.ts index.html README.md",
    "test:server-runtime": "node --no-experimental-require-module scripts/check-server-runtime.mjs",
    "build:api": "node scripts/build-api.mjs"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "firebase": "12.4.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vite": "^7.1.9",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6",
    "jwks-rsa": {
      "jose": "^5.10.0"
    },
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "engines": {
    "node": "24.x"
  }
}
