rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(ownerId) { return request.auth != null && request.auth.uid == ownerId; }
    // Each authenticated owner has an isolated workspace. No public data access.
    match /workspaces/{ownerId}/{collection}/{documentId} {
      allow read: if owner(ownerId)
        && collection in ['settings', 'products', 'customers', 'invoices', 'payments', 'audit', 'counters'];
      // All writes go through the authenticated Vercel API and Admin SDK.
      allow write: if false;
    }
  }
}
